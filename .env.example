# Copy to .env (which is git-ignored) and fill in real values.
# Never commit real tokens/keys — see README "Credential hygiene".

# HuggingFace Hub token, only needed for gated models. Loaded by
# hallucination_energy.generation.generate via `huggingface_hub.login()`.
HF_TOKEN=

# Weights & Biases API key, only needed with --use_wandb.
WANDB_API_KEY=

# Where generation outputs / pickles / model caches are written/read.
SCRATCH_DIR=./outputs
HF_HOME=./.cache/huggingface

# Optional: restrict visible GPUs instead of hardcoding it in a script.
CUDA_VISIBLE_DEVICES=
